---
import Layout from '../layouts/Layout.astro';
import LinkButton from '../components/LinkButton.astro';
---

<Layout title="404">
    <div class="not-found">
        <h2>Oups ! 😅</h2>
        <p>Il semblerait que la page que vous cherchez n&rsquo;existe pas.</p>
        <LinkButton href="/">Retour à l'accueil</LinkButton>
    </div>
</Layout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
  }
  .not-found h2 {
    font-size: 4.5rem;
    font-weight: 700;
    margin-bottom: 4rem;
    color: #fff;
  }
  .not-found p {
    margin-bottom: 2rem;
  }
</style>
