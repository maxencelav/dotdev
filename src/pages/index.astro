---
import { PUBLIC_EMAIL } from 'astro:env/client';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ContactSplitButton from '../components/ContactSplitButton.astro';
import InlineLink from '../components/InlineLink.astro';
import { Image } from 'astro:assets';
import mlPortrait from "/public/assets/img/portrait.png";
import resumePDF from "/public/assets/docs/Maxence_Lavenu_CV.pdf";
---

<Layout title="Maxence Lavenu" containerClasses="flex align-center">
	<div class="flex flex-col md:flex-row items-center justify-between gap-8">
		<div class="basis-2/3">
			<hgroup class="mb-4">
				<h1 class="text-5xl font-bold mb-2 text-gray-950 dark:text-gray-50">Maxence Lavenu</h1>
				<p class="text-xl font-medium text-primary-700 dark:text-primary-400">Développeur front-end</p>
			</hgroup>
			<p class="mb-3 text-base/7">Détenteur d’un titre d'<strong>Analyste développeur d'applications informatiques</strong> (obtenu à la <InlineLink href="https://codingfactory.fr/" target="_blank">Coding Factory by ESIEE-IT</InlineLink>), je suis actuellement développeur front-end chez <InlineLink href="https://wshop.com/" target="_blank">WSHOP</InlineLink>.</p>
			
			<div class="flex flex-col md:flex-row gap-4">
				<ContactSplitButton email={PUBLIC_EMAIL} />
				<Button href={resumePDF} download="Maxence_Lavenu_CV.pdf" target="_blank" variant="secondary">Téléchargez mon CV</Button>
			</div>
		</div>
		<div class="basis-1/3 max-w-1/2 md:max-w-none">
			<Image src={mlPortrait} alt="Maxence Lavenu" class="h-full w-full object-cover select-none" width="384" height="384" fetchpriority="high" loading="eager"/>
		</div>
	</div>
</Layout>

