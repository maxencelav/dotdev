---
import Layout from './Layout.astro';
const { frontmatter } = Astro.props;
const formattedPublishDate = new Date(frontmatter.publishDate).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title={frontmatter.title} noTitle={true}>
    <div class="prose">
        <h2>{frontmatter.title}</h2>
        <span class="meta">{ formattedPublishDate }</span>
        <hr />
        <slot />
    </div>
</Layout>

<style>
  .meta {
    white-space: nowrap;
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  h2 {
    margin-bottom: 1rem;
  }
</style>
