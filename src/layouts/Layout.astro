---
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import mlPortrait from "/public/assets/img/portrait.png";
import "../styles/index.css";

export interface Props {
	title: string;
	noTitle?: boolean;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="color-scheme" content="light dark" />
		<meta name="description" content="Personal website of Maxence Lavenu, a french web developer." />
		<meta property="og:image" content={mlPortrait.src} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title == "Maxence Lavenu" ? "Maxence Lavenu" : title + " - Maxence Lavenu"}</title>
	</head>
	<body>
		<Navbar/>
		<div class="page-wrapper">
			<main>
				<slot />
			</main>
			<Footer/>
		</div>
	</body>
</html>
