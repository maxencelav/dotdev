---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import mlPortrait from "/public/assets/img/portrait.png";


export interface Props {
	title: string;
	containerClasses?: string;
}

const { title, containerClasses } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Personal website of Maxence Lavenu, a french web developer." />
		<meta property="og:image" content={mlPortrait.src} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-noto-sans" preload />
		<Font cssVariable="--font-noto-color-emoji" />
		<title>{title == "Maxence Lavenu" ? "Maxence Lavenu" : title + " - Maxence Lavenu"}</title>
	</head>
	<body class="flex flex-col min-h-screen justify-center mx-auto w-full bg-gray-50 dark:bg-gray-950 overflow-x-hidden">
		<div class="flex flex-col text-gray-600 dark:text-gray-400 grow max-w-6xl w-full mx-auto px-2 z-20 sm:px-16">
			<main class={containerClasses + " " +"grow px-4 py-8 sm:px-16 sm:py-8 w-full max-w-6xl mx-auto"}>
				<slot />
			</main>
			<Footer/>
		</div>
	</body>
</html>