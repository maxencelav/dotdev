---
export interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---

<header class="mb-8">
  <a
    href={href}
    class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 hover:text-primary-700 dark:text-gray-400 dark:hover:text-primary-400 transition-colors duration-300"
  >
    <span aria-hidden="true">&larr;</span>
    {label}
  </a>
</header>
