---
import { externalRel } from '../utils/links';

export interface Props {
  href: string;
  target?: string;
  className?: string;
}
const { href, target, className } = Astro.props;
---

<a
  href={href}
  target={target}
  rel={externalRel(target)}
  class:list={[
    "underline decoration-current/40 hover:decoration-current",
    "transition-colors duration-200 ease-in-out",
    className,
  ]}
>
  <slot />
</a>
