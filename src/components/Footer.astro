---
import { PUBLIC_EMAIL } from 'astro:env/client';
import FooterLink from './FooterLink.astro';
---

<footer class="text-center py-8 text-opacity-50 hover:text-opacity-100 transition-opacity duration-300 flex flex-row flex-wrap justify-between items-center">
    <hr class="mx-auto mb-4 border-gray-600 dark:border-gray-400 opacity-50 w-full text-center" />
    <div class="w-full mb-3">
        <FooterLink href="https://github.com/maxencelav" target="_blank">
            GitHub
        </FooterLink>
        <span class="mx-2 opacity-50">•</span>
        <FooterLink href="https://www.linkedin.com/in/maxence-lavenu/" target="_blank">
            LinkedIn
        </FooterLink>
        <span class="mx-2 opacity-50">•</span>
        <FooterLink href={`mailto:${PUBLIC_EMAIL}`} target="_blank">
            Email
        </FooterLink>
    </div>
</footer>
