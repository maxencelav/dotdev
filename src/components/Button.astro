---
export interface Props {
  href: string;
  variant?: "primary" | "secondary";
  target?: string;
  download?: string;
  className?: string;
}
const { href, variant = "primary", className, target, download } = Astro.props;

const variants = {
  primary: `text-white bg-primary-700 hover:bg-primary-800
            dark:bg-primary-600 dark:hover:bg-primary-700`,
  secondary: `text-primary-700 bg-transparent border border-primary-700 hover:bg-primary-700 hover:text-white
              dark:text-primary-400 dark:border-primary-400 dark:hover:bg-primary-400 dark:hover:text-gray-950`,
};
---

<a
  href={href}
  download={download}
  target={target}
  class:list={[
    "inline-block px-3 py-2 font-medium text-center select-none",
    "transition duration-200 ease-in-out",
    variants[variant],
    className,
  ]}
>
  <slot />
</a>
